# Copie para .env (ignorado pelo git). O Makefile carrega este arquivo; o
# binário em si só lê variáveis de ambiente reais.
#
# PowerShell: Copy-Item .env.example .env
# sh:         cp .env.example .env

# Conexão de runtime (papel ledger_app), usada pelo `serve`.
DATABASE_URL=postgres://ledger_app:ledger_app@localhost:5432/ledger_dev?sslmode=disable
# Dono do schema (papel ledger_owner), usado só pelo `migrate`.
MIGRATE_DATABASE_URL=postgres://ledger_owner:ledger_owner@localhost:5432/ledger_dev?sslmode=disable
# Superusuário de teste (papel ledger_test); os testes criam um banco por teste.
TEST_DATABASE_URL=postgres://ledger_test:ledger_test@localhost:5432/postgres?sslmode=disable

# Banco do teste de carga (make load-db / load-serve), recriado a cada execução.
LOAD_DATABASE_URL=postgres://ledger_app:ledger_app@localhost:5432/ledger_load?sslmode=disable

# Token das rotas /v1/admin (Authorization: Bearer ...). Mínimo de 16 caracteres.
ADMIN_TOKEN=dev-admin-token-change-me

HTTP_ADDR=:8080
LOG_LEVEL=debug
LOG_FORMAT=text
REQUEST_TIMEOUT=5s
# Espera máxima por um lock de conta; precisa ser menor que REQUEST_TIMEOUT.
DB_LOCK_TIMEOUT=2s
DB_MAX_CONNS=10
